# ============================================
# .env.providers
# ============================================
# IMPORTANT: this file is a template. Copy it to .env.providers and keep
# the real file out of git. Never commit real API keys.
#
# Set the example to http://localhost:11434 so it works out of the box
# with local runtimes.

# --- BACKENDS -- Runtime URLs ---
# A backend is a concrete runtime. This section defines only how to
# connect to each one (URL and credential). The per-role model selection
# below (EMBEDDER / LLM_ROL_*) decides which model each pipeline role
# uses.

LLM_FLM_URL=http://127.0.0.1:52625/v1
LLM_OLLAMA_URL=http://127.0.0.1:11434
LLM_GEMINI_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_API_KEY=REPLACE_WITH_YOUR_GEMINI_API_KEY

EMBEDDER_FLM_URL=http://127.0.0.1:52625/v1
EMBEDDER_OLLAMA_URL=http://127.0.0.1:11434

# --- EMBEDDER -- backend + model that generates embeddings ---
# Format: backend,model
# Valid backends: sentence_transformers (in-process, no URL) | ollama | flm
#
# IMPORTANT: changing backend or model invalidates existing indexes.
# Indexes are stored in paths separated by backend/model:
#   <AI_HOME>/vector_stores/<backend>/<model_safe>/<category>/<collection>/
#
# Adding a new model to an existing backend means adding an entry in
# src/config/models/<backend>.py. No new environment variable is needed.

EMBEDDER=ollama,bge-m3

# --- LLM BY ROLE -- backend + model for each pipeline role ---
# Format: backend,model (same as EMBEDDER).
#
# LLM_ROL_GENERATE:   writes the final response (/query, /demo/query, CLI).
# LLM_ROL_SUPPLEMENT: decides whether a web search adds useful information.
#
# LLM_ROL_*_FALLBACK: optional per-role fallback, same backend,model
# format. When configured, the pipeline retries the call on the fallback
# if the primary errors or returns an empty response. Leave it unset or
# empty if you do not want a fallback.
#
# Example local-only setup:
# LLM_ROL_GENERATE=ollama,qwen3.5:4b
# LLM_ROL_SUPPLEMENT=ollama,qwen3.5:4b

LLM_ROL_GENERATE=gemini,gemini-2.5-flash-lite
LLM_ROL_SUPPLEMENT=gemini,gemini-2.5-flash-lite
LLM_ROL_GENERATE_FALLBACK=ollama,qwen3.5:4b
LLM_ROL_SUPPLEMENT_FALLBACK=ollama,qwen3.5:4b
